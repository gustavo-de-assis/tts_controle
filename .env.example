# Variáveis de Ambiente — StockApp Fashion
# Copie este arquivo para .env.local e preencha com suas credenciais reais.

# Supabase / PostgreSQL — obtenha em: https://supabase.com/dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js
AUTH_SECRET="gere-um-segredo-longo-e-aleatorio"

# Seed do administrador inicial (opcional; ambos devem estar configurados)
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="defina-uma-senha-forte"
