// Prisma Schema — StockApp Fashion
// Stack: Next.js 16 + SQLite (Local Dev)
// Entidades mapeadas conforme Regras de Negócio (RN-001 a RN-006)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Categoria — Agrupamento de produtos
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Produto (Pai) — Modelo genérico da peça de roupa
// ---------------------------------------------------------------------------

model Product {
  id            String    @id @default(uuid())
  name          String
  imageUrl      String?   @map("image_url")
  baseCostPrice Float     @map("base_cost_price")
  baseSalePrice Float     @map("base_sale_price")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  categoryId    String    @map("category_id")
  category      Category  @relation(fields: [categoryId], references: [id])

  skus          Sku[]

  @@map("products")
}

// ---------------------------------------------------------------------------
// SKU (Variação) — Item físico estocável: Produto + Cor + Tamanho
// RN-001: estoque NUNCA associado ao Produto Pai, sempre ao SKU.
// ---------------------------------------------------------------------------

model Sku {
  id             String    @id @default(uuid())
  sku            String    @unique // Código único legível, ex: "CAM-PRETA-M"
  color          String
  size           String
  currentStock   Int       @default(0) @map("current_stock")
  minimumStock   Int       @default(0) @map("minimum_stock")
  // Override de preço no nível do SKU (RN-004)
  salePriceOverride Float? @map("sale_price_override")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  productId      String    @map("product_id")
  product        Product   @relation(fields: [productId], references: [id])

  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@map("skus")
}

// ---------------------------------------------------------------------------
// Movimentação — Registro auditável imutável (RN-005)
// Nunca deletar; correções via AJUSTE_PERDA ou DEVOLUCAO.
// ---------------------------------------------------------------------------

model StockMovement {
  id          String       @id @default(uuid())
  type        String       // ENTRADA, SAIDA_VENDA, AJUSTE_PERDA, DEVOLUCAO
  quantity    Int
  unitValue   Float        @map("unit_value")
  observation String?
  createdAt   DateTime     @default(now()) @map("created_at")

  skuId       String       @map("sku_id")
  sku         Sku          @relation(fields: [skuId], references: [id])

  saleId      String?      @map("sale_id")
  sale        Sale?        @relation(fields: [saleId], references: [id])

  // Sem updatedAt: movimentações são imutáveis por design (RN-005)
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Venda — Pedido / Registro de transação (RN-006)
// ---------------------------------------------------------------------------

model Sale {
  id            String        @id @default(uuid())
  totalAmount   Float         @map("total_amount")
  discount      Float         @default(0)
  paymentMethod String        @map("payment_method") // PIX, CARTAO_CREDITO, CARTAO_DEBITO, DINHEIRO
  status        String        @default("CONCLUIDA")  // CONCLUIDA, CANCELADA
  createdAt     DateTime      @default(now()) @map("created_at")

  items         SaleItem[]
  movements     StockMovement[]

  @@map("sales")
}

// ---------------------------------------------------------------------------
// Item de Venda — Cada SKU vendido dentro de uma Venda
// ---------------------------------------------------------------------------

model SaleItem {
  id          String  @id @default(uuid())
  quantity    Int
  unitValue   Float   @map("unit_value")

  saleId      String  @map("sale_id")
  sale        Sale    @relation(fields: [saleId], references: [id])

  skuId       String  @map("sku_id")
  sku         Sku     @relation(fields: [skuId], references: [id])

  @@map("sale_items")
}
